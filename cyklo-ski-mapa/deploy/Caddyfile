# Caddy pro docker-compose.yml (Caddy běží v kontejneru vedle aplikace).
# Doména se bere z proměnné DOMAIN; certifikát z Let's Encrypt si Caddy vystaví sám
# (DNS A záznam domény musí mířit na server a porty 80/443 musí být otevřené).
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:8090
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	log {
		output file /data/access.log {
			roll_size 20mb
			roll_keep 5
		}
	}
}

# Další weby na tomto serveru (Kolomapa …): každý má vlastní soubor ve svazku caddy_config, /config/sites/*.caddy.
# Zapisuje ho skript nasazení té aplikace (kolomapa/deploy/docker/nasadit.sh) – Caddyfile zůstává beze změny
# a klon repozitáře čistý (hetzner.sh aktualizace jinak kód nestahuje). Bez souborů řádek nic nedělá.
import /config/sites/*.caddy
