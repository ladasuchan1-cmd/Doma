# Caddy pro docker-compose.yml (Caddy běží v kontejneru vedle aplikace).
# Doména se bere z proměnné DOMAIN; certifikát z Let's Encrypt si Caddy vystaví sám
# (DNS A záznam domény musí mířit na server a porty 80/443 musí být otevřené).
#
# Za Cloudflare (NASAZENI.md, oddíl „Cloudflare před serverem“): hetzner.sh uloží do /opt/caddy-origin Cloudflare
# Origin certifikát a soubor tls.caddy, který ho zapne – blok domény ho importuje (v kontejneru /etc/caddy/origin).
# Bez něj platí Let's Encrypt. Adresám Cloudflare Caddy důvěřuje vždy – bez Cloudflare to ničemu nevadí.
{
	servers {
		# Skutečná IP klienta z X-Forwarded-For jen od adres Cloudflare (brzda přihlášení v aplikaci, logy).
		# Seznam https://www.cloudflare.com/ips-v4 a /ips-v6, stav 7. 10. 2026.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

{$DOMAIN} {
	# Cloudflare Origin certifikát, je-li zapnutý (hetzner.sh zapíše /opt/caddy-origin/tls.caddy); jinak Let's Encrypt
	import /etc/caddy/origin/*.caddy
	encode zstd gzip
	reverse_proxy app:8090
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	log {
		output file /data/access.log {
			roll_size 20mb
			roll_keep 5
		}
	}
}

# Další weby na témže serveru (např. demo Půjčovny kol): každý má vlastní soubor v /opt/caddy-extra/*.caddy
# (v kontejneru /etc/caddy/extra, viz docker-compose.yml). Prázdný adresář nevadí. Po změně:
#   docker compose -f /opt/Doma/cyklo-ski-mapa/deploy/docker-compose.yml exec caddy caddy reload --config /etc/caddy/Caddyfile
import /etc/caddy/extra/*.caddy

# Weby projektu Kolomapa na témže serveru: soubory /config/sites/*.caddy (zapisuje kolomapa/deploy/docker/nasadit.sh
# do svazku caddy_config). Tento řádek byl dřív jen ručně na serveru – teď je v repu, aby ho aktualizace nesmazala.
import /config/sites/*.caddy
