# Konfigurace serveru Cyklo & Ski mapa – zkopírujte jako .env (do složky s daty, viz NASAZENI.md) a vyplňte.
# Soubor NESMÍ do gitu (je v .gitignore).

# Uživatelé obchodního oddělení: jmeno:heslo oddělené středníkem. Každá změna stavu pak nese, kdo ji udělal.
CSM_USERS=lada:ZmenteHeslo1;obchod:ZmenteHeslo2

# Nebo jedno společné heslo (uživatel „tým“) místo CSM_USERS:
# CSM_PASSWORD=SilneSpolecneHeslo

# Platnost přihlášení ve dnech.
CSM_SESSION_DAYS=30

# Za Caddy / nginx (HTTPS končí na proxy): cookie Secure a skutečná IP klienta z hlaviček proxy.
CSM_TRUST_PROXY=1

# Volitelný token pro externí skripty (Authorization: Bearer …) – např. zálohování /api/stav cronem.
# CSM_TOKEN=nahodny-dlouhy-text

# Klíč pro podpis přihlašovací cookie. Když chybí, vygeneruje se a uloží vedle stav.json jako .secret.
# CSM_SECRET=nahodny-dlouhy-text-aspon-32-znaku
