<?xml version="1.0" encoding="utf-8"?>
<!-- Varianta „lite“: bez služby přístupnosti, aby instalaci nezablokoval Google Play Protect.
     Zbytek manifestu se přebírá z src/main. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:label="@string/app_name_lite"
        tools:replace="android:label">

        <service
            android:name=".service.TermsAccessibilityService"
            tools:node="remove" />
    </application>
</manifest>
