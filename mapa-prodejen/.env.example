# Konfigurace serveru Mapy prodejen – zkopírujte jako .env a vyplňte. Soubor NESMÍ do gitu (je v .gitignore).
# Na serveru ho zapisuje deploy/server.sh (uživatele bere z GitHubu, stejně jako Cyklo & Ski mapa).

# Uživatelé: jmeno:heslo oddělené středníkem. Každá změna pak nese, kdo ji udělal.
MP_USERS=lada:ZmenteHeslo1;obchod:ZmenteHeslo2

# Nebo jedno společné heslo (uživatel „tým“) místo MP_USERS:
# MP_PASSWORD=SilneSpolecneHeslo

# Platnost přihlášení ve dnech.
MP_SESSION_DAYS=30

# Za Caddy (HTTPS končí na proxy): cookie Secure a skutečná IP klienta z hlaviček proxy.
MP_TRUST_PROXY=1

# Volitelný token pro skripty (Authorization: Bearer …) – např. zálohy /api/stav a /api/objednavky.
# MP_TOKEN=nahodny-dlouhy-text

# Klíč pro podpis přihlašovací cookie. Když chybí, vygeneruje se a uloží do datové složky jako .secret.
# MP_SECRET=nahodny-dlouhy-text-aspon-32-znaku

# 0 = nedohledávat v ARES a RÚIAN (server bez přístupu na internet).
# MP_REGISTRY=1

# Asistent mapy (Claude API): bez klíče je vypnutý. Model a „effort“ jsou volitelné.
# ANTHROPIC_API_KEY=sk-ant-...
# MP_AI_MODEL=claude-opus-5-5
# MP_AI_EFFORT=low
