<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView style="@style/SectionTitle" android:layout_marginTop="0dp" android:text="@string/edit_name" />
        <EditText
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences" />

        <TextView style="@style/SectionTitle" android:text="@string/ingredients" />
        <EditText
            android:id="@+id/ingredients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="@string/edit_ingredients_hint"
            android:inputType="textMultiLine"
            android:minLines="4" />

        <TextView style="@style/SectionTitle" android:text="@string/steps" />
        <EditText
            android:id="@+id/steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="@string/edit_steps_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="3" />

        <TextView style="@style/SectionTitle" android:text="@string/keywords" />
        <EditText
            android:id="@+id/keywords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/edit_keywords_hint"
            android:inputType="textMultiLine"
            android:minLines="2" />

        <TextView style="@style/SectionTitle" android:text="@string/notes" />
        <EditText
            android:id="@+id/notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="@string/edit_notes_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="2" />

        <TextView style="@style/SectionTitle" android:text="@string/description" />
        <EditText
            android:id="@+id/description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="@string/edit_description_hint"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:maxLines="12" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/btn_save" />

        <Button
            android:id="@+id/btn_save_reanalyze"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_save_reanalyze" />
    </LinearLayout>
</ScrollView>
