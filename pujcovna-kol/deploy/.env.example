# Půjčovna kol – konfigurace serveru pro deploy/docker-compose.yml. Zkopírujte jako deploy/.env a vyplňte.
# Soubor NESMÍ do gitu (je v .gitignore); hetzner.sh instalace ho vytvoří sám. Proměnné čte src/config.js (SPEC kap. 3).

# Apex doména dema. Caddy z ní odvozuje www., outdoor., sport. a family. subdomény (všech 5 hostů musí mít DNS A/AAAA).
PK_DOMAIN=ksprehledy.cz

# E-mail k účtu Let's Encrypt (upozornění, když se nepodaří obnovit certifikát).
PK_ACME_EMAIL=info@ksprehledy.cz

# Demo režim: přepínač designu ?design=, simulace plateb, demo přihlášení demo@ksprehledy.cz / kolo-demo-2026,
# noční reset demo dat. V ostrém provozu nastavit 0 (pak je povinné PK_ADMIN_PASSWORD, nebo se heslo vypíše do logu).
PK_DEMO=1

# Hodina (Europe/Prague) nočního resetu demo dat; prázdná hodnota = reset vypnutý. Záloha z cronu běží ve 2:30.
PK_RESET_DEMO_HOUR=3

# Při startu kontejneru naplnit demo data (idempotentně). PK_SEED_RESET=1 je navíc smaže a naplní znovu.
PK_SEED_DEMO=1
# PK_SEED_RESET=0

# Výchozí správce při prvním startu (prázdná DB). V demu výchozí demo@ksprehledy.cz / kolo-demo-2026.
# PK_ADMIN_USER=demo@ksprehledy.cz
# PK_ADMIN_PASSWORD=

# Klíč pro HMAC a šifrování polí (AES-256-GCM). Když chybí, vygeneruje se do /data/.secret (práva 600) – NEZTRATIT,
# bez něj jsou šifrované údaje zákazníků nečitelné. Záloha (hetzner.sh zaloha) ho obsahuje.
# PK_SECRET=

# Úroveň logu: debug | info | warn | error | silent (JSON řádky bez osobních údajů).
LOG_LEVEL=info

# Volitelně klíč Mapy.cz (podklad outdoor + výškový profil); bez klíče se použije CyclOSM.
# MAPY_API_KEY=

# Verzi aplikace (APP_VERSION) sem nepište – hetzner.sh ji počítá z gitu (v<datum>-<hash>) a předává při buildu.

# Interní ceník s NÁKUPNÍMI cenami kol pro konfigurátor /nabidka – nikdy do gitu. Výchozí cesta $PK_DATA/nabidka.interni.json
# (v kontejneru /data/nabidka.interni.json v datovém svazku; vzor config/nabidka.interni.example.json). Bez souboru se
# nákupní ceny odvodí z prodejní ceny a prahu marže a interní pohled to označí. Zobrazuje se jen přihlášeným správcům.
# PK_NABIDKA_INTERNI=/data/nabidka.interni.json

# Správa platformy /platforma (pozvánky do průvodce pro nové půjčovny, přehled klientů). Min. 12 znaků; bez ní je
# /platforma vypnutá. Při nasazení z GitHubu se propíše ze secretu PK_PLATFORMA_HESLO. Nikdy nepoužívejte demo heslo.
# PK_PLATFORMA_HESLO=
# Doména, pod kterou průvodce zakládá weby klientů (<slug>.<doména>); výchozí PK_DOMAIN. Potřebuje DNS wildcard *.<doména>.
# PK_KLIENTI_DOMENA=ksprehledy.cz
